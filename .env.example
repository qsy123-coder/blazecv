# 站点对外地址（canonical / OpenGraph / sitemap / robots 使用）
NEXT_PUBLIC_SITE_URL=https://aetouban.cn

# docker-compose 使用：Postgres 密码
POSTGRES_PASSWORD=change-me-before-deploy

# Web 服务连接串；未设置时自动使用本地 PGlite 文件库（仅适合单机/开发）
DATABASE_URL=postgres://blazecv:change-me-before-deploy@localhost:5432/blazecv

# 站点通过 HTTPS 提供服务时设为 true
COOKIE_SECURE=false

# 反向代理提供 HTTPS 时，服务端导出使用的内部 loopback 地址
EXPORT_INTERNAL_ORIGIN=http://127.0.0.1:3000

# PGlite 数据目录（未设置 DATABASE_URL 时生效）
PGLITE_DIR=.data/pglite

# ---------- 手机号验证码登录 ----------
# 短信服务：aliyun | tencent | http（自建/其他网关）。未配置时手机号登录不可用。
# console 仅用于本地联调：验证码会打到服务端日志，切勿用于生产。
SMS_PROVIDER=

# 验证码有效期与重发间隔（秒）
SMS_CODE_TTL_SECONDS=300
SMS_CODE_RESEND_SECONDS=60

# 阿里云短信
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_SMS_REGION=cn-hangzhou
# 模板变量，默认 {"code":"{{code}}"}，可用 {{code}} / {{minutes}}
ALIYUN_SMS_TEMPLATE_PARAM={"code":"{{code}}"}

# 腾讯云短信
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=
TENCENT_SMS_REGION=ap-guangzhou
# 模板变量（逗号分隔，按位置传参），支持 {{code}} / {{minutes}}
TENCENT_SMS_TEMPLATE_PARAMS={{code}},{{minutes}}

# 通用 HTTP 网关：POST JSON { phone, phoneE164, code, expiresIn, template }
SMS_HTTP_URL=
SMS_HTTP_TOKEN=
SMS_HTTP_TEMPLATE=

# ---------- 邮箱验证码（找回密码） ----------
# 邮件服务：smtp | http。未配置时邮箱找回密码不可用；console 仅本地联调。
EMAIL_PROVIDER=

# SMTP（QQ 邮箱 / 163 邮箱需使用「授权码」作为密码，不是登录密码）
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_FROM=
EMAIL_FROM_NAME=BlazeCV
EMAIL_SMTP_REJECT_UNAUTHORIZED=true

# 通用 HTTP 邮件网关：POST JSON { to, subject, text, html, code, purpose, expiresIn }
EMAIL_HTTP_URL=
EMAIL_HTTP_TOKEN=
