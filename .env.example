# 站点对外地址（canonical / OpenGraph / sitemap / robots 使用）
NEXT_PUBLIC_SITE_URL=https://aetouban.cn

# docker-compose 使用：Postgres 密码
POSTGRES_PASSWORD=change-me-before-deploy

# Web 服务连接串；未设置时自动使用本地 PGlite 文件库（仅适合单机/开发）
DATABASE_URL=postgres://blazecv:change-me-before-deploy@localhost:5432/blazecv

# 站点通过 HTTPS 提供服务时设为 true
COOKIE_SECURE=false

# 反向代理提供 HTTPS 时，服务端导出使用的内部 loopback 地址
EXPORT_INTERNAL_ORIGIN=http://127.0.0.1:3000

# PGlite 数据目录（未设置 DATABASE_URL 时生效）
PGLITE_DIR=.data/pglite

# ---------- 手机号验证码登录 ----------
# 短信服务：aliyun | tencent | http（自建/其他网关）。未配置时手机号登录不可用。
# console 仅用于本地联调：验证码会打到服务端日志，切勿用于生产。
SMS_PROVIDER=

# 验证码有效期与重发间隔（秒）
SMS_CODE_TTL_SECONDS=300
SMS_CODE_RESEND_SECONDS=60

# 阿里云短信
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_SMS_REGION=cn-hangzhou
# 模板变量，默认 {"code":"{{code}}"}，可用 {{code}} / {{minutes}}
ALIYUN_SMS_TEMPLATE_PARAM={"code":"{{code}}"}

# 腾讯云短信
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=
TENCENT_SMS_REGION=ap-guangzhou
# 模板变量（逗号分隔，按位置传参），支持 {{code}} / {{minutes}}
TENCENT_SMS_TEMPLATE_PARAMS={{code}},{{minutes}}

# 通用 HTTP 网关：POST JSON { phone, phoneE164, code, expiresIn, template }
SMS_HTTP_URL=
SMS_HTTP_TOKEN=
SMS_HTTP_TEMPLATE=

# ---------- 邮箱验证码（找回密码） ----------
# 邮件服务：smtp | http。未配置时邮箱找回密码不可用；console 仅本地联调。
EMAIL_PROVIDER=

# SMTP（QQ 邮箱 / 163 邮箱需使用「授权码」作为密码，不是登录密码）
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_FROM=
EMAIL_FROM_NAME=BlazeCV
EMAIL_SMTP_REJECT_UNAUTHORIZED=true

# 通用 HTTP 邮件网关：POST JSON { to, subject, text, html, code, purpose, expiresIn }
EMAIL_HTTP_URL=
EMAIL_HTTP_TOKEN=

# ---------- 会员支付 ----------
# 支付总开关；false 时导出无水印（保持旧行为），支付接口返回 503。
PAY_ENABLED=false
# mock：本地全链路验收，不访问微信；wechat：真实微信支付 APIv3（Native 扫码）；
# pingpp：Ping++ 聚合；epay：易支付（彩虹易支付）；payjs：PayJS；
# xunhu：虎皮椒；qrnotify：个人收款码监听（免签）。
PAY_PROVIDER=wechat

# 微信支付 Native（商户平台 -> 产品中心 -> Native 支付）
# direct：直连商户；partner：服务商模式（服务商商户号 + 特约商户号）
WECHAT_PAY_MODE=direct

# 直连商户模式
WECHAT_PAY_APPID=
WECHAT_PAY_MCHID=

# 服务商模式（WECHAT_PAY_MODE=partner 时必填前三项；SUB_APPID 可选）
WECHAT_PAY_SP_APPID=
WECHAT_PAY_SP_MCHID=
WECHAT_PAY_SUB_MCHID=
WECHAT_PAY_SUB_APPID=

WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_MCH_SERIAL_NO=
# 商户私钥：二选一。生产建议 base64 放进 systemd EnvironmentFile（不支持多行）。
WECHAT_PAY_MCH_PRIVATE_KEY_PATH=
WECHAT_PAY_MCH_PRIVATE_KEY_BASE64=
# 微信支付公钥模式（推荐）或平台证书模式
WECHAT_PAY_PUBLIC_KEY_PATH=
WECHAT_PAY_PUBLIC_KEY_BASE64=
WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_PLATFORM_CERT_PATH=
# 回调必须是公网 HTTPS，且已备案
WECHAT_PAY_NOTIFY_URL=https://aetouban.cn/api/pay/notify/wechat

# 仅本地联调可用：指向假微信网关，生产不要设置
# WECHAT_PAY_API_BASE=http://127.0.0.1:9310

# ---------- Ping++ 聚合支付（PAY_PROVIDER=pingpp） ----------
# Dashboard -> 开发信息：API Key、App ID、Ping++ 公钥
PINGPP_API_KEY=
PINGPP_APP_ID=
# 扫码渠道：微信 wx_pub_qr；支付宝 alipay_qr
PINGPP_WECHAT_CHANNEL=wx_pub_qr
PINGPP_ALIPAY_CHANNEL=alipay_qr
# 先只接支付宝时把微信设为 false；支付宝未开通时把支付宝设为 false
PINGPP_WECHAT_ENABLED=true
PINGPP_ALIPAY_ENABLED=true
# 兼容旧配置：微信渠道回退
PINGPP_CHANNEL=wx_pub_qr
# 仅 Ping++ 子商户/服务商层级需要
PINGPP_SUB_MCH_ID=

# 商户 RSA 私钥（本地生成，公钥上传到 Ping++ Dashboard -> 商户 RSA 公钥）
PINGPP_PRIVATE_KEY_PATH=
PINGPP_PRIVATE_KEY_BASE64=
# Ping++ 公钥（Dashboard -> 开发信息），用于 Webhook 验签
PINGPP_PUBLIC_KEY_PATH=
PINGPP_PUBLIC_KEY_BASE64=

# Webhook 地址在 Ping++ Dashboard 配置：
# https://aetouban.cn/api/pay/notify/pingpp

# 仅本地联调：指向假 Ping++ 网关，生产不要设置
# PINGPP_API_BASE=http://127.0.0.1:9320

# ---------- 易支付 / 彩虹易支付（PAY_PROVIDER=epay） ----------
# 商户后台「商户ID / 商户密钥 / 接口地址」三项必填；接口地址不要带 /submit.php
EPAY_GATEWAY=
EPAY_PID=
EPAY_KEY=
# 支付类型：默认微信 wxpay、支付宝 alipay（按网关实际枚举调整）
EPAY_WECHAT_TYPE=wxpay
EPAY_ALIPAY_TYPE=alipay
# 默认只开微信；网关已开通支付宝时设为 true
EPAY_ALIPAY_ENABLED=false
# 回调与同步跳转；留空时回退 NEXT_PUBLIC_SITE_URL
EPAY_NOTIFY_URL=https://aetouban.cn/api/pay/notify/epay
EPAY_RETURN_URL=https://aetouban.cn/membership
EPAY_SITE_NAME=BlazeCV
# 二维码字段：留空按 qrcode -> payurl -> urlscheme 依次回退。
# 若 qrcode 返回图片地址，改成 payurl；若只有原生链接，改成 urlscheme。
EPAY_QR_FIELD=

# ---------- PayJS（PAY_PROVIDER=payjs，微信 Native） ----------
PAYJS_MCHID=
PAYJS_KEY=
PAYJS_API_BASE=https://payjs.cn/api
PAYJS_NOTIFY_URL=https://aetouban.cn/api/pay/notify/payjs

# ---------- 虎皮椒 XunhuPay（PAY_PROVIDER=xunhu） ----------
XUNHU_APPID=
XUNHU_APPSECRET=
XUNHU_API_BASE=https://api.xunhupay.com
XUNHU_NOTIFY_URL=https://aetouban.cn/api/pay/notify/xunhu
XUNHU_RETURN_URL=https://aetouban.cn/membership
# 支付类型：WAP 为 H5 聚合页；按通道实际支持填 wechat / alipay
XUNHU_WECHAT_TYPE=WAP
XUNHU_ALIPAY_TYPE=WAP
XUNHU_ALIPAY_ENABLED=false
XUNHU_WAP_URL=https://aetouban.cn
XUNHU_WAP_NAME=BlazeCV
# 二维码字段：留空优先 url_qrcode，回退 url；可强制 url_qrcode / url
XUNHU_QR_FIELD=

# ---------- 蓝兔支付（PAY_PROVIDER=ltzf，微信 Native） ----------
# 蓝兔后台 -> 商户管理 -> 开发设置：商户号、密钥
LTZF_MCH_ID=
LTZF_KEY=
LTZF_API_BASE=https://api.ltzf.cn
LTZF_NOTIFY_URL=https://aetouban.cn/api/pay/notify/ltzf

# ---------- 个人收款码监听 / 免签（PAY_PROVIDER=qrnotify） ----------
# 回调密钥：监听程序用 HMAC-SHA256 签名，或在 URL 上带 ?token=
QR_NOTIFY_SECRET=
QR_NOTIFY_TOKEN=
# 个人收款码的二维码内容（微信 wxp://... / 支付宝二维码串），不是图片地址
QR_NOTIFY_WECHAT_QR=
QR_NOTIFY_ALIPAY_QR=
# 兼容单通道配置：未设置 QR_NOTIFY_WECHAT_QR 时读取该值
QR_NOTIFY_QR_CONTENT=
# 或者直接托管收款码图片（本地路径，支持 png/jpg/webp/gif）；
# 与上面的内容串二选一，内容串优先。
QR_NOTIFY_WECHAT_QR_IMAGE=
QR_NOTIFY_ALIPAY_QR_IMAGE=
# amount：金额加唯一尾数自动核销（推荐）；remark：金额不变，备注订单号后 6 位
QR_NOTIFY_MATCH=amount
QR_NOTIFY_ALIPAY_ENABLED=false

# 订单二维码有效期（秒），默认 900
PAY_ORDER_TTL_SECONDS=900

# 管理令牌：对账补齐 POST /api/pay/reconcile（x-admin-token / Bearer）。
# 未配置时该接口返回 404。建议放进 systemd timer 每 5–10 分钟跑一次。
PAY_ADMIN_TOKEN=

# ---------- 会员页展示（构建时内联） ----------
NEXT_PUBLIC_BUSINESS_NAME=
NEXT_PUBLIC_ICP=
NEXT_PUBLIC_SUPPORT_EMAIL=support@aetouban.cn
